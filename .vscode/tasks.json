{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Backend",
            "type": "shell",
            "command": "Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }; Write-Host '--- Porta 5000 liberada ---'; Start-Sleep -Seconds 1; Start-Process 'http://localhost:5000'; .\\.venv\\Scripts\\python run.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "isBackground": true
        },
        {
            "type": "npm",
            "script": "install",
            "path": "app/static/editor-react",
            "group": "none",
            "problemMatcher": [],
            "label": "npm: install - app/static/editor-react",
            "detail": "install dependencies from package"
        },
        {
            "label": "Git: Commit & Push (com feedback visual)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\git-commit-push.ps1\"",
            "args": [
                {
                    "value": "${input:commitMessage}",
                    "quoting": "weak"
                }
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Executa git status → add → commit → push com feedback visual claro"
        }
    ],
    "inputs": [
        {
            "id": "commitMessage",
            "type": "promptString",
            "description": "Mensagem do commit",
            "default": "feat: atualização"
        }
    ]
}
